working-directory = ~/workspace
command = /usr/bin/zsh

window-width = 82
window-height = 22
background-opacity = 0.96

# mouse-hide-while-typing = true
# cursor-style = underline
# cursor-style-blink = true
# shell-integration-features = no-cursor

