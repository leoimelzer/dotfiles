working-directory = ~/workspace
command = /usr/bin/zsh

window-width = 82
window-height = 22
background-opacity = 0.96
background-blur-radius = 15
gtk-custom-css = gtk.css

theme = Catppuccin Mocha

cursor-color = #cba6f7
cursor-text = #1e1e2e

selection-background = #4b2a69
selection-foreground = #cdd6f4
